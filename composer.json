{
    "name": "jmonitor/jmonitor-bundle",
    "description": "Symfony bundle to collect server metrics (PHP, MySQL, PostgreSQL, Redis, Apache, Nginx, Caddy, Cloudflare) and send them to jmonitor.io.",
    "keywords": ["monitoring", "metrics", "mysql", "postgresql", "postgres", "apache", "php", "redis", "nginx", "system", "symfony", "caddy", "frankenphp", "cloudflare"],
    "homepage": "https://jmonitor.io",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Johndodev",
            "homepage": "https://jonathan-plantey.fr/"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "jmonitor/collector": "^2.5.1",
        "nyholm/psr7": "^1.8",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-client": "^6.4|^7.0|^8.0",
        "symfony/process": "^6.4|^7.0|^8.0",
        "symfony/clock": "^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.8|^4.0",
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "friendsofphp/php-cs-fixer": "^3.86",
        "monolog/monolog": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/css-selector": "^6.4|^7.0|^8.0",
        "symfony/messenger": "^6.4|^7.0|^8.0",
        "symfony/scheduler": "^6.4|^7.0|^8.0",
        "symfony/security-bundle": "^6.4|^7.0|^8.0",
        "symfony/security-csrf": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0"
    },
    "conflict": {
        "doctrine/dbal": "<3.8"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Stores the application metrics shown on the /jmonitor page",
        "symfony/security-csrf": "Protects the actions of the screens with a CSRF token"
    },
    "autoload": {
        "psr-4": { "Jmonitor\\JmonitorBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Jmonitor\\JmonitorBundle\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-3.x": "3.x-dev",
            "dev-2.x": "2.x-dev",
            "dev-1.x": "1.x-dev"
        }
    },
    "scripts": {
        "lint:check": "./vendor/bin/php-cs-fixer check --verbose --diff",
        "lint:fix": "./vendor/bin/php-cs-fixer fix --verbose --diff",
        "phpstan": "./vendor/bin/phpstan",
        "phpunit": "./vendor/bin/phpunit tests"
    }
}
