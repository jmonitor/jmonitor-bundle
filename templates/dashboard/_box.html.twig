{% autoescape 'html' %}
{% set linked = box.path is not null and (box.path|split('/')|first) in screens %}
{% set framed = box.tone is not null and box.tags|filter(tag => tag.tone == box.tone)|length > 0 %}
{% set element = linked ? 'a' : 'div' %}
<{{ element }} class="jm-box{{ box.value is same as('0') ? ' jm-box--zero' }}{{ framed ? ' jm-box--' ~ box.tone }}"{% if linked %} href="{{ urls.page(box.path, query) ~ (box.anchor is not null ? '#jm-' ~ box.anchor) }}"{% endif %}>
    <span class="jm-box__line">
        <span class="jm-box__name">
            <span class="jm-box__label">{{ box.label }}</span>
{% if box.tags is not empty %}
            <span class="jm-box__tags">
                {%- for tag in box.tags -%}
                    {{ loop.first ? '' : ' ' }}<span class="jm-tag jm-tag--{{ tag.tone }}">{{ tag.text }}</span>
                {%- endfor -%}
            </span>
{% endif %}
        </span>
        <span class="jm-box__value">{{ box.value }}</span>
    </span>
{% if box.series is not empty %}
    {{ jmonitor_sparkline(box.series, box.label) }}
{% endif %}
</{{ element }}>
{% endautoescape %}
