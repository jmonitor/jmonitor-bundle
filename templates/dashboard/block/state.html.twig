{% autoescape 'html' %}
{% set state = block.state.value %}
{% set tone = state in ['no_connection', 'storage_error', 'buffer_unavailable', 'error'] ? 'bad' : 'info' %}
<div class="jm-state jm-state--{{ tone }}"{% if state == 'reading' %} data-jm-reading{% endif %}>
    <svg class="jm-state__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.75"/>
        {% if tone == 'bad' %}
            <line x1="12" y1="7.5" x2="12" y2="13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            <circle cx="12" cy="16.25" r="1.1" fill="currentColor"/>
        {% else %}
            <polyline points="12,7.5 12,12 15,14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        {% endif %}
    </svg>
    {% if state == 'empty' %}
        <h2 class="jm-state__title">{{ block.title }}</h2>
        <p class="jm-state__text">{{ block.text }}</p>
    {% elseif state == 'recording_disabled' %}
        <h2 class="jm-state__title">Recording is off</h2>
        <p class="jm-state__text">Recording is disabled in this environment (<code>jmonitor.recording.enabled</code>).</p>
    {% elseif state == 'buffer_unavailable' %}
        <h2 class="jm-state__title">Buffer directory unusable</h2>
        <p class="jm-state__text">JMonitor cannot write to its buffer directory (<code>jmonitor.recording.buffer_dir</code>, or the system temporary directory). Nothing is recorded until it can.</p>
    {% elseif state == 'no_connection' %}
        <h2 class="jm-state__title">No storage configured</h2>
        <p class="jm-state__text">JMonitor needs a Doctrine DBAL connection to store its data. Install doctrine/doctrine-bundle or set <code>jmonitor.storage.connection</code>.</p>
    {% elseif state == 'reading' %}
        <h2 class="jm-state__title">{{ block.title ?: 'Reading…' }}</h2>
        <p class="jm-state__text">{{ block.text ?: 'JMonitor is reading this section.' }}</p>
    {% elseif state == 'error' %}
        <h2 class="jm-state__title">Section unavailable</h2>
        <p class="jm-state__text">JMonitor could not display this section. Check the application logs.</p>
    {% else %}
        <h2 class="jm-state__title">Storage unavailable</h2>
        <p class="jm-state__text">JMonitor could not read or write its data. Check the application logs.</p>
    {% endif %}
</div>
{% endautoescape %}
