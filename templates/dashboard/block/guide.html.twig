{% autoescape 'html' %}
{% set guide_view = block.content %}
<section class="jm-guide" aria-label="How to read this screen">
    <h2 class="jm-guide__title">How to read this screen</h2>
    <ul class="jm-guide__list">
        {% for item in guide_view.items %}
            {% set shown = item.links|filter(link => (link|split('/')|first) in screens) %}
            <li class="jm-guide__item"><strong>{{ item.term }}</strong> {{ item.text }}
                {%- for label, link in shown -%}
                    {{ loop.first ? ' ' }}<a href="{{ urls.page(link, page.period ? {period: page.period.label} : {}) }}">{{ label }}</a>{% if not loop.last %}<span class="jm-guide__separator" aria-hidden="true"> · </span>{% endif %}
                {%- endfor -%}
            </li>
        {% endfor %}
    </ul>
</section>
{% endautoescape %}
