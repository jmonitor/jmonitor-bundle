{% autoescape 'html' %}
{% set table = block.content %}
{% set section = section ?? null %}
{% set title_id = section ? 'jm-section-' ~ section.id ~ '-title' : 'jm-' ~ table.id ~ '-title' %}
{% set shown = table.rows|filter(row => not row.muted)|length + table.remaining %}
{% set panel = section ? 'div' : 'section' %}
<{{ panel }} class="jm-panel"{% if not section %} aria-labelledby="{{ title_id }}"{% endif %}>
    <div class="jm-panel__header">
{% if not section %}
        <h2 class="jm-panel__title" id="{{ title_id }}">{{ table.title }}</h2>
{% endif %}
        <p class="jm-panel__meta">{{ shown|jmonitor_number }} {{ table.nounFor(shown) }}{% if table.note is not null %}, {{ table.note }}{% endif %}</p>
    </div>
    <div class="jm-table-wrap" id="jm-{{ table.id }}-wrap" role="region" aria-labelledby="{{ title_id }}" tabindex="0">
        <table class="jm-table">
            <thead>
                <tr>
                    {% for column in table.columns %}
                        {% set active = column.sort is not null and column.sort == (section ? section.sort : page.sort) %}
                        {%~ set direction = active ? (section ? section.direction : page.direction) : '' %}
                        <th scope="col" class="{{ column.numeric ? 'jm-num' : 'jm-col-' ~ column.id }}{{ active ? ' is-sorted' }}"
                            {% if active %}aria-sort="{{ direction == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
                            {% if column.sort is not null %}
                                <a class="jm-sort" href="{{ section
                                    ? urls.page(path ?? page.screen.id, (page.period ? {period: page.period.label} : {})|merge({sort: section.id ~ '.' ~ column.sort, dir: section.directionFor(column.sort)})) ~ '#' ~ section.id
                                    : urls.page(path ?? page.screen.id, page.period ? {period: page.period.label, sort: column.sort, dir: page.directionFor(column.sort)} : {}) }}">
                                    <span>{{ column.label }}</span>
                                    <span class="jm-sort__icon" aria-hidden="true">{{ active ? (direction == 'asc' ? '↑' : '↓') : '↕' }}</span>
                                </a>
                            {% else %}
                                {{ column.label }}
                            {% endif %}
                        </th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in table.rows %}
                    <tr{% if row.muted %} class="jm-row--muted"{% endif %}{% for name, value in row.attributes %} {{ name|e('html_attr') }}="{{ value }}"{% endfor %}>
                        {% for column in table.columns %}
                            {% set cell = row.cells[column.id] ?? null %}
                            {% set tag = loop.first ? 'th' : 'td' %}
                            <{{ tag }}{% if loop.first %} scope="row"{% endif %} class="{{ column.numeric ? 'jm-num' : 'jm-col-' ~ column.id }}{{ cell and cell.tone ? ' jm-' ~ cell.tone }}">
                                {%- if cell is null -%}
                                {%- elseif cell.kind == 'code' -%}
                                    <code class="jm-code">{{ cell.text }}</code>
                                {%- elseif cell.kind == 'route' -%}
                                    {% set method = (cell.data.method ?? '')|lower %}
                                    <span class="jm-method jm-method--{{ method in ['get', 'post', 'put', 'patch', 'delete'] ? method : 'other' }}">{{ cell.data.method ?? '' }}</span>
                                    <code class="jm-route{{ cell.text == '(unmatched)' ? ' jm-route--unmatched' }}">{{ cell.text }}</code>
                                {%- elseif cell.kind == 'sql' -%}
                                    {% if cell.text|length > 120 %}
                                        <details class="jm-sql" data-jm-key="{{ row.key }}"><summary><code>{{ cell.text|slice(0, 120) }}</code></summary><pre><code>{{ cell.text }}</code></pre></details>
                                    {% else %}
                                        <code class="jm-sql">{{ cell.text }}</code>
                                    {% endif %}
                                {%- else -%}
                                    {{ cell.text }}
                                {%- endif -%}
                            </{{ tag }}>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if table.remaining > 0 %}
        <p class="jm-panel__footer">{{ table.remaining|jmonitor_number }} more {{ table.nounFor(table.remaining) }} not shown</p>
    {% endif %}
</{{ panel }}>
{% endautoescape %}
