{% extends '@Jmonitor/dashboard/layout.html.twig' %}

{% block title %}JMonitor — Requests{% endblock %}

{% block nav %}
    <a class="jm-nav__item" href="{{ path('jmonitor_dashboard', {period: screen.period.label, sort: screen.sort, dir: screen.direction}) }}" aria-current="page">Requests</a>
{% endblock %}

{% block toolbar %}
    <nav class="jm-period" aria-label="Period">
        <span class="jm-period__label" aria-hidden="true">Period</span>
        <ul class="jm-segmented">
            {% for period in periods %}
                <li>
                    <a class="jm-segmented__item{{ period == screen.period ? ' is-active' }}"
                       href="{{ path('jmonitor_dashboard', {period: period.label, sort: screen.sort, dir: screen.direction}) }}"
                       {% if period == screen.period %}aria-current="true"{% endif %}>{{ period.label }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
    <label class="jm-live" data-jm-live-toggle hidden>
        <input class="jm-live__switch" type="checkbox" role="switch" checked>
        <span class="jm-live__label">Live</span>
    </label>
{% endblock %}

{% block body %}
    {% set period_text = {'1h': 'last hour', '6h': 'last 6 hours', '24h': 'last 24 hours', '7d': 'last 7 days'} %}
    <main id="jm-main" class="jm-main" data-jm-live data-jm-fragment-url="{{ path('jmonitor_dashboard_fragment') }}">
        <div class="jm-heading">
            <h1 class="jm-heading__title">Requests</h1>
            <p class="jm-heading__text">Traffic and response times per route, {{ period_text[screen.period.label] }}.</p>
        </div>
        <div data-jm-content>
            {{ include('@Jmonitor/dashboard/_requests.html.twig') }}
        </div>
    </main>
{% endblock %}
