{% autoescape 'html' %}
{% set opening = page.body[0] ?? null %}
{% set lead_titles = opening is not null and opening.state.value == 'ready' and (opening.type in ['lead', 'status'] or (opening.type == 'tiles' and opening.content|filter(tile => tile.namesPage) is not empty)) %}
<div class="jm-screen" data-jm-state="{{ page.state }}"{% if page.reading %} data-jm-reading{% endif %}>
{% if page.tabs %}
    {{ include('@Jmonitor/dashboard/block/subnav.html.twig', {block: {content: page.tabs}}) }}
{% endif %}
{% if not lead_titles %}
    <div class="jm-heading">
        <h1 class="jm-heading__title">{{ page.screen.label }}</h1>
        <p class="jm-heading__text">{{ page.screen.heading }}{% if page.period %}, {{ page.period|jmonitor_period|lower }}{% endif %}.</p>
    </div>
{% endif %}
{% for block in page.body %}
    {{ include('@Jmonitor/dashboard/block/' ~ (block.state.value == 'ready' ? block.type : 'state') ~ '.html.twig', {block: block, section: null, page_title: lead_titles and loop.first}) }}
{% endfor %}
{% if page.reading %}
    <p class="jm-rest"><a data-jm-rest href="{{ urls.page(path ?? page.screen.id, (page.period ? {period: page.period.label}|merge(page.sort is same as('') ? {} : {sort: page.sort, dir: page.direction}) : {})|merge(page.query)|merge({rest: '1'})) }}">Load the rest</a></p>
{% endif %}
{% for id, badge in badges ?? {} %}
    <template data-jm-slot-content="nav-{{ id }}">{% if badge %}{{ include('@Jmonitor/dashboard/_badge.html.twig', {badge: badge}, with_context = false) }}{% endif %}</template>
{% endfor %}
</div>
{% endautoescape %}
