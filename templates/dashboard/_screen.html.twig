{% autoescape 'html' %}
<div class="jm-screen" data-jm-state="{{ page.state }}"{% if page.reading %} data-jm-reading{% endif %}>
{% for block in page.blocks %}
    {{ include('@Jmonitor/dashboard/block/' ~ (block.state.value == 'ready' ? block.type : 'state') ~ '.html.twig', {block: block}) }}
{% endfor %}
{% if page.reading %}
    <p class="jm-rest"><a data-jm-rest href="{{ urls.page(path ?? page.screen.id, {rest: '1'}) }}">Load the rest</a></p>
{% endif %}
{% for id, badge in badges ?? {} %}
    <template data-jm-slot-content="nav-{{ id }}">{% if badge %}{{ include('@Jmonitor/dashboard/_badge.html.twig', {badge: badge}, with_context = false) }}{% endif %}</template>
{% endfor %}
</div>
{% endautoescape %}
