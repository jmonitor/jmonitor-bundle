{% autoescape 'html' %}
{% set path = path ?? page.screen.id %}
{% set badges = badges ?? {} %}
{% set header = standalone ? 'header' : 'div' %}
{% set main = standalone ? 'main' : 'div' %}
<{{ header }} class="jm-header">
    <div class="jm-header__inner">
        {% if standalone %}
            <a class="jm-brand" href="{{ urls.page('') }}">
                <svg class="jm-brand__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <defs>
                        <linearGradient id="jm-brand-gradient" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#2fceeb"/>
                            <stop offset="1" stop-color="#809dff"/>
                        </linearGradient>
                    </defs>
                    <rect width="24" height="24" rx="6" fill="url(#jm-brand-gradient)"/>
                    <polyline points="4,13 8,13 10,8 14,17 16,11 20,11" fill="none" stroke="#14171a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="jm-brand__name">JMonitor</span>
            </a>
        {% endif %}
        <nav class="jm-nav" aria-label="Screens">
            {% for space in spaces %}
                <a class="jm-nav__item" href="{{ urls.page(space.path, page.period ? {period: page.period.label} : {}) }}"{% if space.current %} aria-current="page"{% endif %}>{{ space.label }}{% if badges[space.id] is defined %}{% set badge = badges[space.id] %} <span data-jm-slot="nav-{{ space.id }}">{% if badge %}{{ include('@Jmonitor/dashboard/_badge.html.twig', {badge: badge}, with_context = false) }}{% endif %}</span>{% endif %}</a>
            {% endfor %}
        </nav>
        <div class="jm-toolbar">
            {% if page.period %}
                <nav class="jm-period" aria-label="Period">
                    <span class="jm-period__label" aria-hidden="true">Period</span>
                    <ul class="jm-segmented">
                        {% for period in periods %}
                            <li>
                                <a class="jm-segmented__item{{ period == page.period ? ' is-active' }}"
                                   href="{{ urls.page(path, {period: period.label, sort: page.sort, dir: page.direction}) }}"
                                   {% if period == page.period %}aria-current="true"{% endif %}>{{ period.label }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% else %}
                <p class="jm-toolbar__note">Read right now, no period</p>
            {% endif %}
            {% for name, label in actions %}
                <form method="post" action="{{ urls.action(path) }}">
                    <input type="hidden" name="action" value="{{ name }}">
                    {% for parameter, value in page.query %}
                        <input type="hidden" name="{{ parameter }}" value="{{ value }}">
                    {% endfor %}
                    {% if token is not null %}
                        <input type="hidden" name="token" value="{{ token }}">
                    {% endif %}
                    <button type="submit" class="jm-button">{{ label }}</button>
                </form>
            {% endfor %}
            <label class="jm-live" data-jm-live-toggle hidden>
                <input class="jm-live__switch" type="checkbox" role="switch" checked>
                <span class="jm-live__label">Live</span>
            </label>
        </div>
    </div>
</{{ header }}>
<{{ main }} id="jm-main" class="jm-main" data-jm-live data-jm-fragment-url="{{ urls.fragment(path, page.query) }}">
    <div data-jm-content>
        {{ include('@Jmonitor/dashboard/_screen.html.twig') }}
    </div>
</{{ main }}>
{% endautoescape %}
