parameters:
    level: 5
    paths:
        - src
    # Only loaded under DBAL 3: its untyped commit() and rollBack() cannot override DBAL 4's void ones,
    # an error phpstan marks as non-ignorable.
    excludePaths:
        analyse:
            - src/Recording/Sql/Dbal/Dbal3Connection.php
    # Some ignores (e.g. version-dependent Symfony methods like Kernel::getShareDir())
    # only match on certain Symfony versions. Don't fail when an ignore is unmatched.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # On Symfony 6.4, DefinitionConfigurator::rootNode() is typed as NodeDefinition
        # (no children()), while at runtime it always returns an ArrayNodeDefinition.
        # From Symfony 7.0 the return type is ArrayNodeDefinition and this won't match.
        -
            message: '#^Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition::children\(\)\.$#'
            path: src/JmonitorBundle.php
        # DBAL 3 names the class SqlitePlatform; PHP class names are case-insensitive, so the
        # instanceof checks match on both versions.
        -
            message: '#^Class Doctrine\\DBAL\\Platforms\\SQLitePlatform not found\.$#'
            path: src/Storage/Dbal/UpsertSql.php
        # DBAL 3 passes the parameters of a prepared statement to execute(); DBAL 4 takes none.
        -
            message: '#^Method Doctrine\\DBAL\\Driver\\Middleware\\AbstractStatementMiddleware::execute\(\) invoked with 1 parameter, 0 required\.$#'
            path: src/Recording/Sql/Dbal/Statement.php
        # Under DBAL 3 the parent's commit() and rollBack() are documented as returning bool; this class
        # is only loaded under DBAL 4, where they are void.
        -
            message: '#^Return type \(void\) of method Jmonitor\\JmonitorBundle\\Recording\\Sql\\Dbal\\Connection::(commit|rollBack)\(\) should be compatible with return type \(bool\) of method Doctrine\\DBAL\\Driver\\(Connection|Middleware\\AbstractConnectionMiddleware)::(commit|rollBack)\(\)\.?$#'
            identifier: method.childReturnType
            path: src/Recording/Sql/Dbal/Connection.php
